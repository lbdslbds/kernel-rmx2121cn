# Experimental ARM64 execution/logging core; NOT an Android/device config.
# Seed for KCONFIG_ALLCONFIG + allnoconfig, followed by olddefconfig and strict checks.
CONFIG_EXPERT=y
CONFIG_ARM64=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_LOCALVERSION="-rmx2121-minimal-core"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LTO_NONE=y
CONFIG_WERROR=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_PREEMPT_NONE=y

# Architectural startup/interrupt/timer infrastructure (many are selected by ARM64).
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_ARM_AMBA=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
# CPU defaults are merged from a real defconfig baseline before allnoconfig.
# These A55/A77 requirements are additionally checked even if the baseline changes.
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_2441007=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_ERRATUM_4118414=y

# External gzip initramfs with static ARM64 /init; no embedded rootfs or forced cmdline.
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_CMDLINE_EXTEND is not set
CONFIG_MULTIUSER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# CONFIG_DEVTMPFS is not set

# PL011 is solely the QEMU virt console; no claim that the phone has this UART.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set
# CONFIG_PSTORE_FTRACE is not set
# CONFIG_PSTORE_BLK is not set

# Deliberately absent subsystems, checked again after Kconfig resolves dependencies.
# CONFIG_MODULES is not set
# CONFIG_BLOCK is not set
# CONFIG_NET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV is not set
# CONFIG_MTD is not set
# CONFIG_NVMEM is not set
# CONFIG_NVME_CORE is not set
# CONFIG_PCI is not set
# CONFIG_I2C is not set
# CONFIG_I3C is not set
# CONFIG_SPI is not set
# CONFIG_SPMI is not set
# CONFIG_PINCTRL is not set
# CONFIG_GPIOLIB is not set
# CONFIG_REGULATOR is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PM is not set
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_REMOTEPROC is not set
